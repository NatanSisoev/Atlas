{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first photo book for two: your photos and videos, read by chapter and day.",
  "type": "module",
  "bin": {
    "atlas": "bin/atlas.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/atlas.js serve",
    "dev": "vite web",
    "build": "vite build web",
    "check": "svelte-check --tsconfig ./web/tsconfig.json --fail-on-warnings && tsc -p web/tsconfig.sw.json",
    "test": "node test/model.mjs && node test/run.mjs",
    "e2e": "node test/e2e.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/justified-layout": "4.1.4",
    "justified-layout": "4.1.0",
    "playwright": "1.56.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
